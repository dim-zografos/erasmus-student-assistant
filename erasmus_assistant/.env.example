# Copy this file to .env and add your key.
# The app also falls back to ../erasmus_discovery/.env if this file is missing.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional overrides. Defaults point to ../erasmus_discovery.
# ERASMUS_DB_PATH=../erasmus_discovery/data/erasmus.db
# ERASMUS_CHROMA_PATH=../erasmus_discovery/chroma_db
